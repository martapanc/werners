# Neon Postgres connection string (use the *pooled* endpoint — host contains "-pooler")
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Unpooled endpoint — `prisma migrate` needs a direct connection
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Signs the session JWT. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"

# Guards /api/cron/reset. Generate with: openssl rand -base64 32
CRON_SECRET="change-me"
